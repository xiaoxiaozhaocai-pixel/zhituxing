{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "src/app/industry-map/**/*.tsx",
    "src/app/industry-map/**/*.ts",
    "src/components/industry-map/**/*.tsx",
    "src/components/industry-map/**/*.ts",
    "src/lib/industry-map/**/*.ts",
    "src/app/api/industry-map/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "scripts", "zhituxing"]
}
